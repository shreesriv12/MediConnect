# Backend Production Environment Template
# Copy this to .env in the backend directory and fill in your values

# ==================== SERVER ====================
NODE_ENV=production
PORT=5000

# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://shreeya:shreeya@cluster0.wplasb9.mongodb.net/?appName=Cluster0
DB_NAME=MediConnect

# ==================== JWT SECRETS ====================
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_32_character_access_token_secret_generated_via_crypto
REFRESH_TOKEN_SECRET=your_32_character_refresh_token_secret_generated_via_crypto

# ==================== TWILIO (SMS OTP) ====================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_xxx
TWILIO_PHONE_NUMBER=+1234567890

# ==================== EMAIL (NODEMAILER) ====================
# Gmail: Use App Password (NOT regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=mediconnect12@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_16_chars

# ==================== CLOUDINARY (FILE UPLOADS) ====================
# Get from: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================== CHAT DOCUMENT UPLOADS ====================
# Local storage is used automatically when AWS_S3_BUCKET/AWS_REGION are not set.
CHAT_UPLOAD_MAX_SIZE_BYTES=10485760
BACKEND_PUBLIC_URL=https://your-render-backend-url.onrender.com

# Optional private S3 storage for chat documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_private_chat_upload_bucket
AWS_SIGNED_URL_EXPIRES_SECONDS=3600

# ==================== RAG DOCUMENT Q&A ====================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_TOKENS=800
HUGGINGFACE_API_KEY=your_optional_hugging_face_token
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_EMBEDDING_BATCH_SIZE=8
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=medical-chat
PINECONE_DIMENSION=384
PINECONE_CREATE_INDEX=false
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULT_LIMIT=4
WEB_SEARCH_TIMEOUT_MS=8000
# Optional preferred web search providers. When absent, DuckDuckGo HTML fallback is used.
BRAVE_SEARCH_API_KEY=your_optional_brave_search_key
SERPER_API_KEY=your_optional_serper_key

# ==================== CORS & FRONTEND ====================
FRONTEND_URL=https://your-frontend-vercel-url.vercel.app
ALLOWED_ORIGINS=https://your-frontend-vercel-url.vercel.app

# ==================== COOKIES ====================
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=your-render-backend-url.onrender.com

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== LOGGING ====================
LOG_LEVEL=info
